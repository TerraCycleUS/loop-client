#!/bin/sh
# Enable in a fresh clone with: git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed — secret scanning is required before commit." >&2
  echo "pre-commit: install it with 'brew install gitleaks' (https://github.com/gitleaks/gitleaks#installing)" >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --verbose
